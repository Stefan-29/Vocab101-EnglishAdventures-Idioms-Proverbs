generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  idioms    Idiom[]
  proverbs  Proverb[]
}

model Idiom {
  id                   String         @id @default(cuid())
  type                 String         @default("IDIOM")
  phrase               String         @unique
  meaning              String
  example              String
  indonesianEquivalent String?
  register             String? // e.g. formal, informal
  difficulty           String? // e.g. A1..C2 or numeric
  usageNotes           String?
  commonMistakes       String?
  // stored as a JSON stringified array or comma-separated tags
  thematicTags         String?
  // stored as a JSON stringified array of example contexts
  exampleContexts      String?
  audioUrl             String?
  source               String?
  categoryId           String?
  category             Category?      @relation(fields: [categoryId], references: [id])
  userProgress         UserProgress[] @relation("IdiomProgress")
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
}

model Proverb {
  id                   String         @id @default(cuid())
  type                 String         @default("PROVERB")
  phrase               String         @unique
  meaning              String
  example              String
  indonesianEquivalent String?
  register             String? // e.g. formal, informal
  difficulty           String? // e.g. A1..C2 or numeric
  usageNotes           String?
  commonMistakes       String?
  // stored as a JSON stringified array or comma-separated tags
  thematicTags         String?
  // stored as a JSON stringified array of example contexts
  exampleContexts      String?
  audioUrl             String?
  source               String?
  categoryId           String?
  category             Category?      @relation(fields: [categoryId], references: [id])
  userProgress         UserProgress[] @relation("ProverbProgress")
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
}

model UserProgress {
  id             String    @id @default(cuid())
  userId         String
  idiomId        String?
  proverbId      String?
  repetitions    Int       @default(0)
  easeFactor     Float     @default(2.5)
  interval       Int       @default(0)
  dueAt          DateTime  @default(now())
  lastReviewedAt DateTime?
  correctCount   Int       @default(0)
  incorrectCount Int       @default(0)
  isMastered     Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // relation back to user
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  idiom   Idiom?   @relation("IdiomProgress", fields: [idiomId], references: [id])
  proverb Proverb? @relation("ProverbProgress", fields: [proverbId], references: [id])

  @@unique([userId, idiomId], map: "user_progress_user_id_idiom_id_unique")
  @@unique([userId, proverbId], map: "user_progress_user_id_proverb_id_unique")
  @@index([userId, dueAt])
}

// User model and NextAuth-compatible models for Prisma adapter
model User {
  id            String         @id @default(cuid())
  name          String?
  email         String?        @unique
  emailVerified DateTime?
  image         String?
  // hashed password for Credentials provider (nullable when using OAuth-only accounts)
  passwordHash  String?
  // role as string to avoid enum incompatibilities on some SQLite setups
  role          String         @default("USER")
  googleId      String?        @unique
  accounts      Account[]
  sessions      Session[]
  progress      UserProgress[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
