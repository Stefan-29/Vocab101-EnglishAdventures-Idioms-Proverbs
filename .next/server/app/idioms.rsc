s text-slate-400","children":"JSON"}]]}],["$","$L6",null,{"href":"/","className":"flex items-center justify-between rounded-xl px-3 py-2.5 text-sm font-medium text-slate-600 transition hover:bg-white hover:text-slate-900","children":[["$","span",null,{"children":"Public App"}],["$","span",null,{"className":"text-xs text-slate-400","children":"Home"}]]}]]}]]}],["$","div",null,{"children":[["$","section",null,{"className":"mb-6 flex flex-col gap-3 rounded-2xl border border-slate-200 bg-slate-50 p-4 sm:flex-row sm:items-center sm:justify-between","children":[["$","div",null,{"className":"text-sm text-slate-700","children":["Showing ",["$","span",null,{"className":"font-medium","children":60}]," items"]}],["$","div",null,{"className":"text-sm text-slate-500","children":"Professional view — suitable for SaaS"}]]}],["$","section",null,{"children":["$","div",null,{"className":"grid grid-cols-1 gap-6 sm:grid-cols-2 xl:grid-cols-3","children":[["$","div","cmt7ipm3m01cn1ty87h0uflze",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"middle of the road","meaning":"Not extreme; ordinary, safe, and acceptable to most people.","example":"The singer's new song is quite middle of the road — nothing too surprising.","type":"IDIOM","tone":"professional"}]}],["$","div","cmt7ipm3b01cl1ty84syab2wm",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"road rage","meaning":"Anger and aggressive behavior by a driver toward other drivers.","example":"Road rage caused the two drivers to shout at each other after the small accident.","type":"IDIOM","tone":"professional"}]}],["$","div","cmt7ipm3601cj1ty868uoligs",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"take someone for a ride","meaning":"To trick or cheat someone.","example":"The seller took him for a ride by charging double the normal price.","type":"IDIOM","tone":"professional"}]}],["$","div","cmt7ipm2z01ch1ty8a0m4pfcr",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"(put the) pedal to the metal","meaning":"To go faster or work harder to speed something up.","example":"We put the pedal to the metal in the last five minutes to finish the poster on time.","type":"IDIOM","tone":"professional"}]}],["$","div","cmt7ipm2q01cf1ty8bjrerome",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"make your way to (somewhere)","meaning":"To travel to a place, usually without much trouble.","example":"Please make your way to the school hall after the bell rings.","type":"IDIOM","tone":"professional"}]}],["$","div","cmt7ipm2i01cd1ty8ysj0kl7f",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"fall off the back of a lorry","meaning":"Describes goods that were probably stolen (often said as a joke).","example":"That phone is so cheap, it must have fallen off the back of a lorry!","type":"IDIOM","tone":"professional"}]}],["$","div","cmt7ipm2e01cb1ty8ika3emmz",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"jump the lights","meaning":"To drive through a red traffic light instead of stopping.","example":"The driver jumped the lights and almost hit a cyclist.","type":"IDIOM","tone":"professional"}]}],["$","div","cmt7ipm2401c91ty8sg254mhb",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"itchy feet","meaning":"A strong wish to travel or move to a new place.","example":"After one year in the same city, Dewi got itchy feet and planned a big trip.","type":"IDIOM","tone":"professional"}]}],["$","div","cmt7ipm1v01c71ty8rjh0728l",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"on the home stretch","meaning":"Close to finishing something, like a task, race, or journey.","example":"We've answered 18 of 20 questions — we're on the home stretch now!","type":"IDIOM","tone":"professional"}]}],["$","div","cmt7ipm1r01c51ty8jcj1zhc8",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"my way or the highway","meaning":"You must accept my plan, or you can leave.","example":"The coach said, 'It's my way or the highway,' so the team followed his training plan.","type":"IDIOM","tone":"professional"}]}],["$","div","cmt7ipm1g01c31ty8n155xjy8",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"hit the road","meaning":"To start a journey.","example":"It's 6 a.m. — time to hit the road if we want to reach the beach by lunch.","type":"IDIOM","tone":"professional"}]}],["$","div","cmt7ipm1801c11ty8eay9zr9a",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"highways and byways","meaning":"All the big and small roads or places of a country.","example":"The old man had traveled the highways and byways of his country for fifty years.","type":"IDIOM","tone":"professional"}]}],["$","div","cmt7ipm1201bz1ty8oi6nvtnw",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"backseat driver","meaning":"Someone who gives unwanted advice or instructions, especially about something they are not doing themselves.","example":"My uncle is a real backseat driver — he tells the chef how to cook even though he never cooks himself.\"\n\nHit the Road! (Road & Journey Idioms)","type":"IDIOM","tone":"professional"}]}],["$","div","cmt7ipm0o01bx1ty8u68vgmi5",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"drive (someone) up the wall","meaning":"To annoy or irritate someone a lot.","example":"My little brother's singing at 6 a.m. drives me up the wall.","type":"IDIOM","tone":"professional"}]}],["$","div","cmt7ipm0801bt1ty8gqdn5eaw",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"put the cart before the horse","meaning":"To do things in the wrong order.","example":"Buying the puppy's clothes before you even have a puppy is putting the cart before the horse.","type":"IDIOM","tone":"professional"}]}],["$","div","cmt7ipm0001bq1ty8zi8q6ewy",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"any port in a storm","meaning":"When you are in trouble, you accept a solution you would not normally choose.","example":"It started raining hard, so we ran into the nearest shop — any port in a storm!\"\n\nOn the Move (Horse, Cart & Driving Idioms)","type":"IDIOM","tone":"professional"}]}],["$","div","cmt7iplzk01bo1ty8qdd6uxmb",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"paddle one's own canoe","meaning":"To do things by yourself, without help from other people.","example":"Instead of joining a group, Rani decided to paddle her own canoe and build the project alone.","type":"IDIOM","tone":"professional"}]}],["$","div","cmt7iplz801bm1ty8zij1p46d",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"rock the boat","meaning":"To do or say something that causes trouble in a situation that was calm before.","example":"The team was working well together, so nobody wanted to rock the boat with new rules.","type":"IDIOM","tone":"professional"}]}],["$","div","cmt7iplyr01bi1ty8sfuhm0fs",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"in the same boat","meaning":"To be in the same difficult situation as someone else.","example":"All the students forgot their homework, so they were all in the same boat.","type":"IDIOM","tone":"professional"}]}],["$","div","cmt7iplyi01bg1ty8fpu49t2o",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"jump on the bandwagon","meaning":"To start doing something only because it has suddenly become popular.","example":"When everyone started collecting the new stickers, Tomo jumped on the bandwagon and started collecting them too.","type":"IDIOM","tone":"professional"}]}],["$","div","cmt7ioubg01bd1ty81xfokgvf",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"for the time being","meaning":"For now, but maybe not forever; temporarily.","example":"We're using the classroom next door for the time being while ours is being painted.","type":"IDIOM","tone":"professional"}]}],["$","div","cmt7ioubc01bb1ty8a4tg86m3",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"have the time of your life","meaning":"To enjoy yourself very, very much.","example":"We had the time of our lives at the amusement park.","type":"IDIOM","tone":"professional"}]}],["$","div","cmt7ioub401b91ty8cakhgam4",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"time on your hands","meaning":"Having a lot of free time, more than you need.","example":"During the holidays, I have a lot of time on my hands, so I started painting.","type":"IDIOM","tone":"professional"}]}],["$","div","cmt7iouaq01b51ty8ksfcrtlq",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"five o'clock shadow","meaning":"The short stubble on a man's face after not shaving for a day.","example":"Dad had a five o'clock shadow after the long camping trip.","type":"IDIOM","tone":"professional"}]}],["$","div","cmt7iouae01b31ty849884uhj",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"the small hours","meaning":"The very early hours after midnight.","example":"He stayed up studying until the small hours before the big test.","type":"IDIOM","tone":"professional"}]}],["$","div","cmt7ioua901b11ty8gaf05sra",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"only time will tell","meaning":"We won't know the result of something until later.","example":"Will the new player be a good captain? Only time will tell.","type":"IDIOM","tone":"professional"}]}],["$","div","cmt7ioua101az1ty84n5mkx90",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"make up for lost time","meaning":"To work extra hard or fast to catch up after a delay.","example":"After being sick all week, she worked hard to make up for lost time at school.","type":"IDIOM","tone":"professional"}]}],["$","div","cmt7iou9x01ax1ty8ae2y5bb8",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"lose track of time","meaning":"To become so busy or interested in something that you forget how much time has passed.","example":"I lost track of time while reading and missed dinner.","type":"IDIOM","tone":"professional"}]}],["$","div","cmt7iou9p01av1ty8iaoot9id",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"have time on your side / time on your side","meaning":"To have plenty of time, so there's no need to rush.","example":"We don't need to hurry with the project — we have time on our side.","type":"IDIOM","tone":"professional"}]}],["$","div","cmt7iou9h01at1ty8jsni4zui",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"time flies","meaning":"Time passes very quickly, especially when you're having fun.","example":"Time flies when we're playing games together!","type":"IDIOM","tone":"professional"}]}],["$","div","cmt7iou9d01ar1ty8cdh9u255",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"like clockwork","meaning":"Happening exactly as planned, very regularly and reliably.","example":"The school bus arrives like clockwork every morning at 7:15.","type":"IDIOM","tone":"professional"}]}],["$","div","cmt7iou9001ap1ty8dpt2ixzj",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"in your own sweet time","meaning":"Taking as long as you want, even if others are waiting.","example":"He finished his breakfast in his own sweet time while everyone waited by the door.","type":"IDIOM","tone":"professional"}]}],["$","div","cmt7iou8w01an1ty8tocckrsj",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"in the long run","meaning":"Over a long period of time in the future; eventually.","example":"Practicing every day is hard now, but it will help in the long run.","type":"IDIOM","tone":"professional"}]}],["$","div","cmt7iou8m01al1ty8ry52jvkn",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"in the interim","meaning":"During the time between two events.","example":"The library is closed for repairs; in the interim, we can borrow books online.","type":"IDIOM","tone":"professional"}]}],["$","div","cmt7iou8g01aj1ty8d3y51ggl",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"by degrees","meaning":"Slowly and gradually, little by little.","example":"By degrees, the shy new student made more friends in class.","type":"IDIOM","tone":"professional"}]}],["$","div","cmt7iou8501ah1ty811jgskl1",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"all along","meaning":"The whole time, from the very beginning.","example":"My glasses were on my head all along!","type":"IDIOM","tone":"professional"}]}],["$","div","cmt7iou8101af1ty8g5cpvu4i",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"time and tide wait for none","meaning":"Time keeps moving no matter what, so don't delay important things.","example":"Finish your project tonight — time and tide wait for none!\"\n\nTime Flies (Passing of Time & Daily Life)","type":"IDIOM","tone":"professional"}]}],["$","div","cmt7iou7r01ad1ty8z8v550z7",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"shelf life","meaning":"The length of time something stays good or useful before it should be used.","example":"Check the shelf life on the milk before you pour it into your cereal.","type":"IDIOM","tone":"professional"}]}],["$","div","cmt7iou7n01ab1ty8zq5izd3s",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"stuck in a time warp","meaning":"Not changed at all since the past, even though everything around it has changed.","example":"That old candy shop feels stuck in a time warp from the 1980s.","type":"IDIOM","tone":"professional"}]}],["$","div","cmt7iou7301a71ty8c8g0i47y",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"a time-honoured practice","meaning":"A tradition that has been respected and followed for a long time.","example":"Singing the school song on the first day is a time-honoured practice here.","type":"IDIOM","tone":"professional"}]}],["$","div","cmt7iou6v01a51ty8lze4mfx8",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"stand the test of time","meaning":"To still be useful, popular, or true after many years.","example":"This board game has stood the test of time — kids still love it today.","type":"IDIOM","tone":"professional"}]}],["$","div","cmt7iou6r01a31ty8w0pev7tb",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"since time immemorial","meaning":"For so long that nobody remembers a time before it.","example":"That old oak tree has stood in the park since time immemorial.","type":"IDIOM","tone":"professional"}]}],["$","div","cmt7iou6c01a11ty88sy0tl01",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"until you're blue in the face","meaning":"Trying very hard for a long time, usually without success.","example":"I explained the rules until I was blue in the face, but he still didn't understand.","type":"IDIOM","tone":"professional"}]}],["$","div","cmt7iou67019z1ty8dw5t5zu8",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"until hell freezes over","meaning":"For an extremely long time, even forever (used to mean something will never happen).","example":"You can ask until hell freezes over — I'm still not sharing my dessert!","type":"IDIOM","tone":"professional"}]}],["$","div","cmt7iou5z019x1ty8hipatrhq",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"time after time","meaning":"Again and again; repeatedly.","example":"He forgot his lunchbox time after time, so his mom started leaving notes.","type":"IDIOM","tone":"professional"}]}],["$","div","cmt7iou5v019v1ty82jgag6cw",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"once in a blue moon","meaning":"Something that happens very rarely.","example":"We only get snow here once in a blue moon.","type":"IDIOM","tone":"professional"}]}],["$","div","cmt7iou5p019t1ty8qton1pe3",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"in a month of Sundays","meaning":"A funny way of saying 'a very long time.'","example":"I haven't visited my cousins in a month of Sundays.","type":"IDIOM","tone":"professional"}]}],["$","div","cmt7iou5h019r1ty8hkuxn6yz",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"for donkey's years","meaning":"For a very long time.","example":"My grandfather has lived in this village for donkey's years.","type":"IDIOM","tone":"professional"}]}],["$","div","cmt7iou5b019p1ty8il24bl0r",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"a sign of the times","meaning":"Something that shows what life or society is like today.","example":"Everyone reading on tablets instead of paper books is a sign of the times.\"\n\nHow Long? How Often? (Duration & Frequency)","type":"IDIOM","tone":"professional"}]}],["$","div","cmt7iou53019n1ty8x15cbnc6",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"never in a million years","meaning":"Absolutely never; something you're sure will not happen.","example":"Never in a million years did I think I'd win first prize!","type":"IDIOM","tone":"professional"}]}],["$","div","cmt7iou4y019l1ty8gyiudax1",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"call it a day","meaning":"To stop doing something for now, usually because you're tired.","example":"We've practiced for two hours — let's call it a day and rest.","type":"IDIOM","tone":"professional"}]}],["$","div","cmt7iou4s019j1ty8tisrz3o3",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"on the cusp","meaning":"At the point where something is about to begin or change.","example":"Our class is on the cusp of moving up to the next reading level.","type":"IDIOM","tone":"professional"}]}],["$","div","cmt7iou4k019h1ty8z5e8g6f2",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"only/just a matter of time","meaning":"Something is certain to happen eventually, even if we don't know exactly when.","example":"It's just a matter of time before she beats her own running record.","type":"IDIOM","tone":"professional"}]}],["$","div","cmt7iou4f019f1ty83gavubee",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"that ship has sailed","meaning":"A chance has already passed and it's too late now.","example":"I wanted to join the choir, but auditions ended yesterday — that ship has sailed.","type":"IDIOM","tone":"professional"}]}],["$","div","cmt7iou44019d1ty8zksq8c0o",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"the time is ripe","meaning":"The perfect moment to do something has arrived.","example":"The coach said the time was ripe to try the new team strategy.","type":"IDIOM","tone":"professional"}]}],["$","div","cmt7iou3y019b1ty80wcsp0m4",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"the moment of truth","meaning":"The important moment when you find out if something worked or not.","example":"This is the moment of truth — let's open the exam results together.","type":"IDIOM","tone":"professional"}]}],["$","div","cmt7iou3m01991ty8j0nnk3ev",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"just around the corner","meaning":"Something will happen very soon.","example":"Summer holidays are just around the corner!","type":"IDIOM","tone":"professional"}]}],["$","div","cmt7iou3f01971ty80wgb246b",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"a day late and a dollar short","meaning":"Something that arrives too late and isn't good enough anyway.","example":"He offered to help clean up after everyone had already gone home — a day late and a dollar short.","type":"IDIOM","tone":"professional"}]}],["$","div","cmt7iou3701951ty88r2zjiur",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"better late than never","meaning":"It is better to do something late than not do it at all.","example":"You finally sent the birthday card — better late than never!","type":"IDIOM","tone":"professional"}]}],["$","div","cmt7iou3301931ty8zb2jmqzm",{"className":"flex justify-center","children":["$","$L7",null,{"phrase":"in no time","meaning":"Very soon or very quickly.","example":"Don't worry, you'll learn the dance steps in no time.\"\n\nRight Place, Right Time (Timing, Chance & Opportunity)","type":"IDIOM","tone":"professional"}]}]]}]}]]}]]}]]}]}]}]
